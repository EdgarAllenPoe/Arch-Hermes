
    local swapdev
    while read -r swapdev; do
        [[ -n "$swapdev" ]] || continue
        if [[ "$swapdev" == "$TARGET_DISK"* ]]; then
            swapoff "$swapdev" 2>/dev/null || true
        fi
    done < <(awk 'NR>1 {print $1}' /proc/swaps 2>/dev/null || true)

    # Try to unmount any child partition that may have been automounted.
    local child mp
    while IFS= read -r child; do
        [[ -n "$child" ]] || continue
        mp="$(findmnt -rn -S "$child" -o TARGET 2>/dev/null | head -n1 || true)"
        [[ -n "$mp" ]] && umount "$child" 2>/dev/null || true
    done < <(lsblk -lnpo NAME "$TARGET_DISK" | tail -n +2)

    wipefs -af "$TARGET_DISK"
    parted -s "$TARGET_DISK" mklabel gpt
    parted -s "$TARGET_DISK" mkpart ESP fat32 1MiB "$((EFI_SIZE_MIB + 1))MiB"
    parted -s "$TARGET_DISK" set 1 esp on
    parted -s "$TARGET_DISK" mkpart root ext4 "$((EFI_SIZE_MIB + 1))MiB" 100%

    command -v partprobe >/dev/null 2>&1 && partprobe "$TARGET_DISK" || true
    udevadm settle

    [[ -b "$EFI_PART" ]] || die "EFI partition did not appear at $EFI_PART."
    [[ -b "$ROOT_PART" ]] || die "Root partition did not appear at $ROOT_PART."
    ok "GPT partition table created."
}

format_and_mount() {
    CURRENT_STAGE="format-and-mount"
    info "Formatting EFI partition as FAT32..."
    mkfs.fat -F 32 -n HERMES_EFI "$EFI_PART"
    info "Formatting root partition as ext4..."
    mkfs.ext4 -F -L HERMES_ROOT "$ROOT_PART"

    unmount_target_tree
    mkdir -p "$MOUNTPOINT"
    mount "$ROOT_PART" "$MOUNTPOINT"
    mkdir -p "$MOUNTPOINT/boot"
    mount "$EFI_PART" "$MOUNTPOINT/boot"

    mkdir -p "$(state_dir)/completed"
    append_log "STARTED fresh_install target=$TARGET_DISK installer=$INSTALLER_VERSION"
    mark_stage "partition-disk"
    mark_stage "format-and-mount"
    ok "Filesystems are mounted at $MOUNTPOINT."
}

parent_disk_of_partition() {
    local part="$1" parent
    parent="$(lsblk -nr -o PKNAME "$part" 2>/dev/null | head -n1 || true)"
    [[ -n "$parent" ]] || return 1
    printf '/dev/%s' "$parent"
}

mount_existing_install() {
    local rootdev="$1" efidev="$2"
    unmount_target_tree
    mount "$rootdev" "$MOUNTPOINT"
    mkdir -p "$MOUNTPOINT/boot"
    mount "$efidev" "$MOUNTPOINT/boot"
    ROOT_PART="$rootdev"
    EFI_PART="$efidev"
    TARGET_DISK="$(parent_disk_of_partition "$ROOT_PART" || true)"
    [[ -n "$TARGET_DISK" ]] || die "Could not determine the parent disk for $ROOT_PART."
}

recovery_shell() {
    say
    warn "Recovery shell opened. The target system remains mounted at $MOUNTPOINT."
    if [[ -x "$MOUNTPOINT/bin/bash" ]]; then
        say "Entering the installed system with arch-chroot. Type 'exit' to return to the installer."
        arch-chroot "$MOUNTPOINT" /bin/bash || true
    else
        say "The installed base system is incomplete. Opening the live ISO shell instead."
        say "Target root (if present) is mounted at $MOUNTPOINT. Type 'exit' to return."
        bash || true
    fi
}

offer_resume_if_available() {
    local -a roots=() efis=()
    mapfile -t roots < <(blkid -t LABEL=HERMES_ROOT -o device 2>/dev/null || true)
    mapfile -t efis < <(blkid -t LABEL=HERMES_EFI -o device 2>/dev/null || true)

    (( ${#roots[@]} == 1 && ${#efis[@]} >= 1 )) || return 1

    local rootdev="${roots[0]}" rootdisk efidev="" e e_disk
    rootdisk="$(parent_disk_of_partition "$rootdev" || true)"
    [[ -n "$rootdisk" ]] || return 1
    [[ -n "$LIVE_BOOT_DISK" && "$rootdisk" == "$LIVE_BOOT_DISK" ]] && return 1

    for e in "${efis[@]}"; do
        e_disk="$(parent_disk_of_partition "$e" || true)"
        if [[ "$e_disk" == "$rootdisk" ]]; then
            efidev="$e"
            break
        fi
    done
    [[ -n "$efidev" ]] || return 1

    mount_existing_install "$rootdev" "$efidev"
    if [[ ! -d "$(state_dir)/completed" ]]; then
        unmount_target_tree
        return 1
    fi

    local completed=0
    [[ -f "$(state_dir)/completed/complete" ]] && completed=1

    while :; do
        say
        if (( completed )); then
            warn "A completed Hermes installation is already present on $TARGET_DISK."
            say "1) Open recovery shell"
            say "2) Reinstall from scratch (requires a new ERASE confirmation)"
            say "3) Exit without changing anything"
        else
            warn "A partial Hermes installation was found on $TARGET_DISK."
            local last
            last="$(awk -F= '$1=="last_completed" {print $2}' "$(state_dir)/status" 2>/dev/null | tail -n1 || true)"
            [[ -n "$last" ]] && say "Last completed stage: $last"
            say "1) Resume from the first incomplete stage"
            say "2) Open recovery shell"
            say "3) Restart from scratch (requires a new ERASE confirmation)"
            say "4) Exit without changing anything"
        fi

        local choice
        read -r -p "Choose: " choice
        if (( completed )); then
            case "$choice" in
                1) recovery_shell ;;
                2) unmount_target_tree; RESUME_MODE=0; return 1 ;;
                3) exit 0 ;;
                *) warn "Choose 1, 2, or 3." ;;
            esac
        else
            case "$choice" in
                1)
                    RESUME_MODE=1
                    append_log "RESUME requested installer=$INSTALLER_VERSION"
                    ok "Resume mode selected."
                    return 0
                    ;;
                2) recovery_shell ;;
                3) unmount_target_tree; RESUME_MODE=0; return 1 ;;
