        type="$(lsblk -dn -o TYPE "$disk" 2>/dev/null || true)"
        ro="$(lsblk -dn -o RO "$disk" 2>/dev/null || true)"
        rm="$(lsblk -dn -o RM "$disk" 2>/dev/null || true)"
        [[ "$type" == "disk" && "$ro" == "0" ]] || continue
        [[ -n "$LIVE_BOOT_DISK" && "$disk" == "$LIVE_BOOT_DISK" ]] && continue
        [[ "$rm" == "1" ]] && continue
        printf '%s\n' "$disk"
    done < <(lsblk -dpno NAME,TYPE 2>/dev/null | awk '$2 == "disk" {print $1}')
}

select_target_disk() {
    CURRENT_STAGE="disk-selection"
    local -a disks=()
    mapfile -t disks < <(list_candidate_disks)
    (( ${#disks[@]} )) || die "No eligible internal installation disk was found."

    say
    say "Eligible internal installation disks:"
    local i disk size model tran
    for i in "${!disks[@]}"; do
        disk="${disks[$i]}"
        size="$(lsblk -dn -o SIZE "$disk" | xargs)"
        model="$(lsblk -dn -o MODEL "$disk" | xargs)"
        tran="$(lsblk -dn -o TRAN "$disk" | xargs)"
        [[ -n "$model" ]] || model="unknown model"
        [[ -n "$tran" ]] || tran="unknown bus"
        printf '  %2d) %-16s  %-9s  %-10s  %s\n' "$((i + 1))" "$disk" "$size" "$tran" "$model"
    done
    say

    while :; do
        local choice
        read -r -p "Select installation disk number: " choice
        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#disks[@]} )); then
            TARGET_DISK="${disks[$((choice - 1))]}"
            break
        fi
        warn "Enter one of the displayed numbers."
    done

    local bytes
    bytes="$(lsblk -bdn -o SIZE "$TARGET_DISK" | xargs)"
    [[ "$bytes" =~ ^[0-9]+$ ]] || die "Could not determine target-disk size."
    (( bytes >= MIN_DISK_BYTES )) || die "The selected disk is smaller than 16 GiB."
    [[ -z "$LIVE_BOOT_DISK" || "$TARGET_DISK" != "$LIVE_BOOT_DISK" ]] \
        || die "Refusing to erase the live installer disk."

    EFI_PART="$(partition_path "$TARGET_DISK" 1)"
    ROOT_PART="$(partition_path "$TARGET_DISK" 2)"
}

confirm_erase() {
    say
    printf '%s%sFINAL DISK CHECK%s\n' "$C_RED" "$C_BOLD" "$C_RESET"
    say "The following disk will be COMPLETELY ERASED:"
    say
    lsblk -o NAME,SIZE,MODEL,TYPE,FSTYPE,MOUNTPOINTS "$TARGET_DISK"
    say
    say "Target: $TARGET_DISK"
    say "EFI:    $EFI_PART"
    say "Root:   $ROOT_PART"
    say
    local confirmation
    read -r -p "Type ERASE exactly to continue: " confirmation
    [[ "$confirmation" == "ERASE" ]] || die "Erase confirmation not received. No disk changes were made."
}

capture_root_password() {
    local p1 p2
    say
    say "Set the password for local root login and the initial SSH login."
    while :; do
        read -r -s -p "New root password: " p1; say
        [[ -n "$p1" ]] || { warn "Password cannot be blank."; continue; }
        read -r -s -p "Retype root password: " p2; say
        [[ "$p1" == "$p2" ]] || { warn "Passwords did not match."; continue; }
        ROOT_PASSWORD="$p1"
        unset p1 p2
        ok "Root password captured for this installation session."
        return 0
    done
}

unmount_target_tree() {
    if mountpoint -q "$MOUNTPOINT" 2>/dev/null; then
        umount -R "$MOUNTPOINT" 2>/dev/null || true
    fi
}

partition_and_mount() {
    CURRENT_STAGE="partition-and-format"
    info "Erasing and partitioning $TARGET_DISK..."
    unmount_target_tree

    local swapdev child mp
    while read -r swapdev; do
        [[ -n "$swapdev" ]] || continue
        [[ "$swapdev" == "$TARGET_DISK"* ]] && swapoff "$swapdev" 2>/dev/null || true
    done < <(awk 'NR > 1 {print $1}' /proc/swaps 2>/dev/null || true)

    while IFS= read -r child; do
        [[ -n "$child" ]] || continue
        mp="$(findmnt -rn -S "$child" -o TARGET 2>/dev/null | head -n1 || true)"
        [[ -n "$mp" ]] && umount "$child" 2>/dev/null || true
    done < <(lsblk -lnpo NAME "$TARGET_DISK" | tail -n +2)

    wipefs -af "$TARGET_DISK"
    parted -s "$TARGET_DISK" mklabel gpt
    parted -s "$TARGET_DISK" mkpart ESP fat32 1MiB "$((EFI_SIZE_MIB + 1))MiB"
    parted -s "$TARGET_DISK" set 1 esp on
    parted -s "$TARGET_DISK" mkpart root ext4 "$((EFI_SIZE_MIB + 1))MiB" 100%
