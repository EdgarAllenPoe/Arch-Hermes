    command -v partprobe >/dev/null 2>&1 && partprobe "$TARGET_DISK" || true
    udevadm settle

    [[ -b "$EFI_PART" ]] || die "EFI partition did not appear at $EFI_PART."
    [[ -b "$ROOT_PART" ]] || die "Root partition did not appear at $ROOT_PART."

    mkfs.fat -F 32 -n ARCH_SSH_EFI "$EFI_PART"
    mkfs.ext4 -F -L ARCH_SSH_ROOT "$ROOT_PART"

    mkdir -p "$MOUNTPOINT"
    mount "$ROOT_PART" "$MOUNTPOINT"
    mkdir -p "$MOUNTPOINT/boot"
    mount "$EFI_PART" "$MOUNTPOINT/boot"
    ok "Disk partitioning, formatting, and mounting completed."
}

install_base() {
    CURRENT_STAGE="base-install"
    local -a packages=(
        base
        linux
        linux-firmware
        networkmanager
        openssh
        curl
        ca-certificates
    )
    [[ -n "$MICROCODE_PKG" ]] && packages+=("$MICROCODE_PKG")
    info "Installing minimal Arch Linux, NetworkManager, and OpenSSH..."
    pacstrap -K "$MOUNTPOINT" "${packages[@]}"
}

configure_system() {
    CURRENT_STAGE="system-config"
    info "Configuring the installed system..."
    genfstab -U "$MOUNTPOINT" > "$MOUNTPOINT/etc/fstab"

    ln -sf "/usr/share/zoneinfo/$TIMEZONE_VALUE" "$MOUNTPOINT/etc/localtime"
    arch-chroot "$MOUNTPOINT" hwclock --systohc

    if grep -Eq '^#?[[:space:]]*en_US\.UTF-8[[:space:]]+UTF-8' "$MOUNTPOINT/etc/locale.gen"; then
        sed -i -E 's/^#[[:space:]]*(en_US\.UTF-8[[:space:]]+UTF-8)/\1/' "$MOUNTPOINT/etc/locale.gen"
    else
        printf 'en_US.UTF-8 UTF-8\n' >> "$MOUNTPOINT/etc/locale.gen"
    fi
    arch-chroot "$MOUNTPOINT" locale-gen
    printf 'LANG=%s\n' "$LOCALE_VALUE" > "$MOUNTPOINT/etc/locale.conf"
    printf 'KEYMAP=%s\n' "$KEYMAP_VALUE" > "$MOUNTPOINT/etc/vconsole.conf"
    printf '%s\n' "$HOSTNAME_VALUE" > "$MOUNTPOINT/etc/hostname"
    cat > "$MOUNTPOINT/etc/hosts" <<EOF_HOSTS
127.0.0.1 localhost
::1       localhost
127.0.1.1 ${HOSTNAME_VALUE}.localdomain ${HOSTNAME_VALUE}
EOF_HOSTS

    printf 'root:%s\n' "$ROOT_PASSWORD" | arch-chroot "$MOUNTPOINT" chpasswd
    ROOT_PASSWORD=""
    unset ROOT_PASSWORD

    arch-chroot "$MOUNTPOINT" systemctl enable systemd-timesyncd.service >/dev/null
    ok "Locale, clock, hostname, and root password configured."
}

install_bootloader() {
    CURRENT_STAGE="bootloader"
    local root_uuid
    root_uuid="$(blkid -s UUID -o value "$ROOT_PART")"
    [[ -n "$root_uuid" ]] || die "Could not determine root filesystem UUID."

    bootctl --esp-path="$MOUNTPOINT/boot" install
    mkdir -p "$MOUNTPOINT/boot/loader/entries"
    cat > "$MOUNTPOINT/boot/loader/loader.conf" <<'EOF_LOADER'
default arch-ssh.conf
timeout 3
console-mode keep
editor no
EOF_LOADER

    {
        echo "title   Arch Linux - SSH Bootstrap"
        echo "linux   /vmlinuz-linux"
        [[ -n "$MICROCODE_INITRD" ]] && echo "initrd  $MICROCODE_INITRD"
        echo "initrd  /initramfs-linux.img"
        echo "options root=UUID=$root_uuid rw"
    } > "$MOUNTPOINT/boot/loader/entries/arch-ssh.conf"

    {
        echo "title   Arch Linux - SSH Bootstrap (fallback initramfs)"
        echo "linux   /vmlinuz-linux"
        [[ -n "$MICROCODE_INITRD" ]] && echo "initrd  $MICROCODE_INITRD"
        echo "initrd  /initramfs-linux-fallback.img"
        echo "options root=UUID=$root_uuid rw"
    } > "$MOUNTPOINT/boot/loader/entries/arch-ssh-fallback.conf"

    [[ -f "$MOUNTPOINT/boot/vmlinuz-linux" ]] || die "Kernel missing from the EFI partition."
    [[ -f "$MOUNTPOINT/boot/initramfs-linux.img" ]] || die "Initramfs missing from the EFI partition."
    ok "systemd-boot installed and configured."
}

