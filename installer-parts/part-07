    say "Then press ENTER to reboot into the new Arch Linux system."
    read -r
    reboot
}

main() {
    banner
    require_root
    require_uefi
    require_commands
    detect_live_boot_disk
    detect_microcode

    configure_wifi

    if offer_resume_if_available; then
        RESUME_MODE=1
        detect_microcode
    else
        RESUME_MODE=0
        select_target_disk
        confirm_erase
        capture_root_password
        partition_disk
        format_and_mount
    fi

    # In resume mode, reconstruct target paths from labels/mount state and make
    # sure the state directory still belongs to the intended disk.
    if (( RESUME_MODE )); then
        [[ -b "$ROOT_PART" && -b "$EFI_PART" ]] || die "Resume target partitions are missing."
        write_status "$(awk -F= '$1=="last_completed" {print $2}' "$(state_dir)/status" 2>/dev/null | tail -n1 || true)"
    fi

    run_stage "base-install" install_base
    run_stage "system-config" configure_system
    run_stage "bootloader" install_bootloader
    run_stage "wifi-persist" persist_wifi
    run_stage "root-password" apply_root_password
    run_stage "hermes-install" install_hermes
    run_stage "firstboot-helper" install_firstboot
    run_stage "final-verify" verify_installation

    finish_install
}

main "$@"
