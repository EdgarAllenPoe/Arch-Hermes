        "$MOUNTPOINT/etc/NetworkManager/system-connections/${CONNECTION_NAME}.nmconnection"
    install -m 644 "$TARGET_FILES/etc/ssh/sshd_config.d/10-arch-ssh-bootstrap.conf" \
        "$MOUNTPOINT/etc/ssh/sshd_config.d/10-arch-ssh-bootstrap.conf"
    install -m 755 "$TARGET_FILES/usr/local/sbin/arch-ssh-firstboot" \
        "$MOUNTPOINT/usr/local/sbin/arch-ssh-firstboot"
    install -m 600 "$TARGET_FILES/root/.bash_profile" "$MOUNTPOINT/root/.bash_profile"

    arch-chroot "$MOUNTPOINT" systemctl disable iwd.service systemd-networkd.service \
        systemd-networkd-wait-online.service systemd-resolved.service >/dev/null 2>&1 || true
    arch-chroot "$MOUNTPOINT" systemctl enable NetworkManager.service sshd.service >/dev/null

    arch-chroot "$MOUNTPOINT" ssh-keygen -A
    mkdir -p "$MOUNTPOINT/run/sshd"
    arch-chroot "$MOUNTPOINT" sshd -t

    ok "NetworkManager and SSH are installed, enabled, and configuration-tested."
}

verify_installation() {
    CURRENT_STAGE="final-verification"
    local failed=0 mode

    [[ -s "$MOUNTPOINT/etc/fstab" ]] || { fail "Missing fstab"; failed=1; }
    [[ -f "$MOUNTPOINT/boot/loader/entries/arch-ssh.conf" ]] || { fail "Missing boot entry"; failed=1; }
    [[ -f "$MOUNTPOINT/boot/vmlinuz-linux" ]] || { fail "Missing kernel"; failed=1; }
    [[ -f "$MOUNTPOINT/boot/initramfs-linux.img" ]] || { fail "Missing initramfs"; failed=1; }
    [[ -f "$MOUNTPOINT/etc/NetworkManager/system-connections/${CONNECTION_NAME}.nmconnection" ]] \
        || { fail "Missing Wi-Fi profile"; failed=1; }
    [[ -x "$MOUNTPOINT/usr/local/sbin/arch-ssh-firstboot" ]] \
        || { fail "Missing first-boot verifier"; failed=1; }

    mode="$(stat -c '%a' "$MOUNTPOINT/etc/NetworkManager/system-connections/${CONNECTION_NAME}.nmconnection")"
    [[ "$mode" == "600" ]] || { fail "Wi-Fi profile mode is $mode, expected 600"; failed=1; }

    arch-chroot "$MOUNTPOINT" systemctl is-enabled NetworkManager.service >/dev/null 2>&1 \
        || { fail "NetworkManager is not enabled"; failed=1; }
    arch-chroot "$MOUNTPOINT" systemctl is-enabled sshd.service >/dev/null 2>&1 \
        || { fail "sshd is not enabled"; failed=1; }

    local ssh_effective
    ssh_effective="$(arch-chroot "$MOUNTPOINT" sshd -T 2>/dev/null)"
    grep -qx 'permitrootlogin yes' <<< "$ssh_effective" \
        || { fail "Effective SSH config does not permit root login"; failed=1; }
    grep -qx 'passwordauthentication yes' <<< "$ssh_effective" \
        || { fail "Effective SSH config does not allow password authentication"; failed=1; }

    (( failed == 0 )) || die "Final verification found one or more problems."

    # This must be the final target-resolver operation. arch-chroot temporarily
    # binds a resolver file over the target path, so no chroot calls may follow.
    rm -f "$MOUNTPOINT/etc/resolv.conf"
    cp -L /etc/resolv.conf "$MOUNTPOINT/etc/resolv.conf"
    chmod 644 "$MOUNTPOINT/etc/resolv.conf"

    ok "All pre-reboot installation checks passed."
}

finish_install() {
    CURRENT_STAGE="complete"
    sync
    unmount_target_tree

    say
    say "============================================================"
    printf '%s%s                  INSTALLATION COMPLETE%s\n' "$C_GREEN" "$C_BOLD" "$C_RESET"
    say "============================================================"
    say
    say "Installed system:"
    say "  Disk:       $TARGET_DISK"
    say "  Hostname:   $HOSTNAME_VALUE"
    say "  Boot:       systemd-boot / UEFI"
    say "  Network:    NetworkManager + saved Wi-Fi profile"
    say "  SSH:        OpenSSH enabled; root password login temporarily allowed"
    say "  Hermes:     not installed"
    say
    say "Next:"
    say "  1. Remove the USB drive."
    say "  2. Press ENTER to reboot."
    say "  3. Log in as root on the laptop."
    say "  4. The first-boot verifier will display the exact Windows SSH command."
    say "  5. It will not report success until a real remote SSH login is detected."
    say
    read -r -p "Remove the USB, then press ENTER to reboot..." _
    reboot
}

main() {
    : > "$LOG_FILE"
    banner
    require_root
    require_uefi
    require_commands
    require_files
    detect_live_boot_disk
