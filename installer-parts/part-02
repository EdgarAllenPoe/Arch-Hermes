    [[ -n "$file" && -f "$file" ]] || return 1
    printf '%s\n' "$file"
}

configure_wifi() {
    CURRENT_STAGE="wifi"
    WIFI_IFACE="$(find_wifi_interface || true)"
    [[ -n "$WIFI_IFACE" ]] || die "No Wi-Fi interface was detected."
    info "Wi-Fi interface: $WIFI_IFACE"

    while :; do
        local -a ssids=()
        local choice password_file password=""
        mapfile -t ssids < <(scan_ssids "$WIFI_IFACE")

        say
        if (( ${#ssids[@]} )); then
            say "Available Wi-Fi networks:"
            local i
            for i in "${!ssids[@]}"; do
                printf '  %2d) %s\n' "$((i + 1))" "${ssids[$i]}"
            done
            say "   M) Enter a hidden or unlisted SSID manually"
            say
            read -r -p "Select network number or M: " choice
            if [[ "$choice" =~ ^[Mm]$ ]]; then
                read -r -p "Enter the Wi-Fi SSID exactly: " WIFI_SSID
            elif [[ "$choice" =~ ^[0-9]+$ ]] \
                && (( choice >= 1 && choice <= ${#ssids[@]} )); then
                WIFI_SSID="${ssids[$((choice - 1))]}"
            else
                warn "Choose one of the displayed numbers or M."
                continue
            fi
        else
            warn "No numbered scan results were returned."
            read -r -p "Enter the Wi-Fi SSID exactly: " WIFI_SSID
        fi
        [[ -n "$WIFI_SSID" ]] || { warn "SSID cannot be blank."; continue; }

        read -r -s -p "Wi-Fi password (leave blank only for an open network): " password
        say

        nmcli connection delete "$CONNECTION_NAME" >/dev/null 2>&1 || true
        nmcli connection add type wifi ifname "$WIFI_IFACE" con-name "$CONNECTION_NAME" \
            ssid "$WIFI_SSID" connection.autoconnect yes ipv4.method auto ipv6.method auto >/dev/null

        if [[ -n "$password" ]]; then
            nmcli connection modify "$CONNECTION_NAME" wifi-sec.key-mgmt wpa-psk
            password_file="$(mktemp)"
            chmod 600 "$password_file"
            printf '802-11-wireless-security.psk:%s\n' "$password" > "$password_file"
            if ! nmcli --wait 45 connection up "$CONNECTION_NAME" ifname "$WIFI_IFACE" \
                passwd-file "$password_file"; then
                rm -f "$password_file"
                password=""
                warn "Wi-Fi connection failed. Check the network and password."
                continue
            fi
            rm -f "$password_file"
        else
            if ! nmcli --wait 45 connection up "$CONNECTION_NAME" ifname "$WIFI_IFACE"; then
                warn "Open-network connection failed."
                continue
            fi
        fi
        password=""
        unset password

        nmcli connection modify "$CONNECTION_NAME" connection.autoconnect yes connection.permissions ""
        nmcli connection reload

        info "Testing IP routing, DNS, and HTTPS..."
        local n
        for n in {1..30}; do
            if network_ready; then
                WIFI_PROFILE_FILE="$(locate_live_profile || true)"
                [[ -n "$WIFI_PROFILE_FILE" ]] \
                    || die "Wi-Fi connected, but NetworkManager did not save a persistent profile."
                chmod 600 "$WIFI_PROFILE_FILE"
                ok "Wi-Fi, routing, DNS, HTTPS, and profile persistence are working."
                return 0
            fi
            sleep 1
        done

        warn "The Wi-Fi connection did not pass the full internet test."
        nmcli device status || true
        ip -4 addr show dev "$WIFI_IFACE" || true
        ip route || true
        cat /etc/resolv.conf || true
        say
        say "1) Retry Wi-Fi setup"
        say "2) Open nmtui"
        say "3) Exit installer"
        read -r -p "Choose: " choice
        case "$choice" in
            2) nmtui || true ;;
            3) exit 1 ;;
            *) : ;;
        esac
    done
}

partition_path() {
    local disk="$1" number="$2"
    if [[ "$disk" =~ [0-9]$ ]]; then
        printf '%sp%s' "$disk" "$number"
    else
        printf '%s%s' "$disk" "$number"
    fi
}

