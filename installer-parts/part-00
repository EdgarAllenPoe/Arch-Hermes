#!/usr/bin/env bash
# Minimal Arch Linux installer for a reliable Wi-Fi + root SSH bootstrap.
set -Eeuo pipefail
IFS=$'\n\t'
umask 077

INSTALLER_VERSION="2026.08.28-ssh1"
MOUNTPOINT="/mnt"
TARGET_FILES="/usr/local/share/arch-ssh-bootstrap/target-files"
CONNECTION_NAME="arch-ssh-wifi"
HOSTNAME_VALUE="arch-hermes"
TIMEZONE_VALUE="America/New_York"
LOCALE_VALUE="en_US.UTF-8"
KEYMAP_VALUE="us"
EFI_SIZE_MIB=1024
MIN_DISK_BYTES=$((16 * 1024 * 1024 * 1024))
CURRENT_STAGE="startup"
LIVE_BOOT_DISK=""
TARGET_DISK=""
EFI_PART=""
ROOT_PART=""
MICROCODE_PKG=""
MICROCODE_INITRD=""
WIFI_IFACE=""
WIFI_SSID=""
WIFI_PROFILE_FILE=""
LOG_FILE="/tmp/arch-ssh-install.log"

C_RESET=$'\033[0m'
C_BOLD=$'\033[1m'
C_RED=$'\033[31m'
C_GREEN=$'\033[32m'
C_YELLOW=$'\033[33m'
C_BLUE=$'\033[34m'

say()  { printf '%s\n' "$*"; }
info() { printf '%s==>%s %s\n' "$C_BLUE" "$C_RESET" "$*"; }
ok()   { printf '%s[OK]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s[WARN]%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
fail() { printf '%s[FAIL]%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }
die()  { fail "$*"; exit 1; }
append_log() { printf '%s %s\n' "$(date -Is 2>/dev/null || date)" "$*" >> "$LOG_FILE"; }

banner() {
    clear 2>/dev/null || true
    cat <<'EOF_BANNER'
============================================================
             ARCH LINUX WI-FI + SSH INSTALLER
============================================================

This installer will erase one selected internal disk and install:
  - minimal console-only Arch Linux
  - NetworkManager with persistent Wi-Fi
  - OpenSSH with temporary root password login
  - a first-boot test that waits for a real remote SSH login

Hermes is intentionally NOT installed by this ISO.
EOF_BANNER
    say
    warn "Nothing is erased until you select a disk and type ERASE exactly."
    say
}

on_error() {
    local rc=$? line="${1:-?}" command="${2:-unknown}"
    set +e
    say
    fail "Installation stopped during stage: $CURRENT_STAGE"
    fail "Command failed at line $line (exit $rc): $command"
    append_log "ERROR stage=$CURRENT_STAGE exit=$rc line=$line command=$command"
    say
    say "No additional disk changes will be made automatically."
    say "Diagnostic log: $LOG_FILE"
    say "Reboot from the USB to start a fresh installation after correcting the problem."
    exit "$rc"
}
trap 'on_error "$LINENO" "$BASH_COMMAND"' ERR

require_root() {
    [[ $(id -u) -eq 0 ]] || die "Run this installer as root."
}

require_uefi() {
    [[ -d /sys/firmware/efi/efivars ]] || die "Boot the USB in UEFI mode."
}

require_files() {
    [[ -d "$TARGET_FILES" ]] || die "The ISO is missing its target-files directory."
    [[ -x "$TARGET_FILES/usr/local/sbin/arch-ssh-firstboot" ]] \
        || die "The ISO is missing the first-boot verifier."
}

require_commands() {
    local missing=() cmd
    for cmd in \
        arch-chroot awk blkid bootctl curl findmnt genfstab getent grep ip lsblk \
        mkfs.ext4 mkfs.fat mount mountpoint nmcli nmtui pacstrap parted readlink \
        reboot sed ssh-keygen sshd ss stat swapoff sync systemctl tail udevadm \
        umount wipefs xargs; do
        command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
    done
    if (( ${#missing[@]} )); then
        fail "The custom ISO is missing required commands:"
        printf '  %s\n' "${missing[@]}" >&2
        die "Rebuild the ISO with the required packages."
    fi
}

