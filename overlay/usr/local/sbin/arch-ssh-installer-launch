#!/usr/bin/env bash
set -Eeuo pipefail

# The stock ArchISO may start iwd/systemd-networkd. This installer uses one
# network manager only: NetworkManager with its packaged wpa_supplicant backend.
systemctl stop iwd.service systemd-networkd.service systemd-networkd-wait-online.service \
    systemd-resolved.service 2>/dev/null || true
rm -f /etc/resolv.conf
: > /etc/resolv.conf
chmod 644 /etc/resolv.conf
systemctl restart NetworkManager.service

# Harmless serial marker used by automated ISO boot smoke tests.
if [[ -c /dev/ttyS0 ]]; then
    printf 'ARCH_SSH_INSTALLER_READY\n' > /dev/ttyS0 2>/dev/null || true
fi

exec /usr/local/bin/arch-ssh-install
