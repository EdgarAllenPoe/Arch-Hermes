#!/usr/bin/env bash
set -uo pipefail

clear 2>/dev/null || true
/usr/local/bin/hermes-install
rc=$?

printf '\n'
printf '============================================================\n'
printf 'Hermes installer exited with code %s.\n' "$rc"
printf 'A recovery shell is now available on tty1.\n'
printf 'Run:  hermes-install\n'
printf 'to retry or resume the installer.\n'
printf 'You can also switch to tty2 with Ctrl+Alt+F2.\n'
printf '============================================================\n\n'

exec /bin/bash -l
